# Пример переменных для docker compose (см. docker-compose.yml).
#
# Скопируйте в .env (файл в .gitignore) и при необходимости поправьте:
#   cp .env.example .env
#
# НЕ коммитьте .env с реальными секретами.

# Версия проекта для /api/health. Пусто — берётся из .git при сборке (hatch-vcs).
# APP_VERSION=0.5.2

# Публикация веб-UI:
#   HOST_PORT — адрес на хосте (127.0.0.1 — только локально; 0.0.0.0 — вся сеть).
#   HOST      — адрес прослушивания ВНУТРИ контейнера.
#   PORT      — порт внутри контейнера и на хосте.
HOST_PORT=127.0.0.1
HOST=0.0.0.0
PORT=8790

# uid/gid пользователя app (только rootful Docker, если владелец ./web-data
# не 1000). Пусто — значения по умолчанию 1000. В rootless/userns не действует.
# PUID=1000
# PGID=1000

# Секреты (необязательно; пустые значения игнорируются).
# HF_TOKEN/HUGGING_FACE_HUB_TOKEN читаются huggingface_hub и движком диаризации
# pyannote (скачивание gated-моделей). Чтобы токен отображался в UI, задайте его
# в мастере первого запуска (сохранится в ./web-data/secrets.json, права 0600).
# HF_TOKEN=hf_...
# HUGGING_FACE_HUB_TOKEN=hf_...
#
# ВНИМАНИЕ: LLM_API_KEY/API_KEY веб-приложение читает из config.env или UI, а НЕ
# из process env — в .env их задавать бесполезно. Используйте UI → «Настройки»
# или примонтируйте config.env (см. docker-compose.yml).
# LLM_API_KEY=sk-...
# API_KEY=...

# AMD ROCm (экспериментально): индекс колёс PyTorch для сборки образа.
# Требуются устройства /dev/kfd и /dev/dri; ASR/LLM по-прежнему через Vulkan.
# Не забудьте раскомментировать проброс TORCH_INDEX в docker-compose.yml.
# TORCH_INDEX=https://download.pytorch.org/whl/rocm6.2
