# Скопируйте этот файл в config.env и укажите свои значения.
# config.env не попадает в git (см. .gitignore) — токен и личные настройки
# останутся только у вас на компьютере.
#
# Пустое значение параметра означает "не передавать его программе" —
# будет использовано поведение по умолчанию (см. README).

# Токен доступа Hugging Face для модели диаризации.
# Как получить — см. README, раздел "Токен доступа для диаризации".
HF_TOKEN=

# Путь к локальной копии модели диаризации (директория с config.yaml).
# Если задан — модель грузится с диска полностью офлайн, токен и сеть не нужны.
PYANNOTE_LOCAL_MODEL=

# Модель распознавания faster-whisper: tiny, base, small, medium,
# large-v3-turbo, large-v3.
MODEL=large-v3-turbo

# Движок распознавания: faster-whisper (CUDA/CPU), whisper-cpp
# (GPU через Vulkan — для AMD-карт без ROCm) или gigaam (GigaAM v3 RU через
# onnx-asr/ONNX Runtime, без torch; опциональная зависимость onnx-asr[cpu,hub]).
ASR_BACKEND=faster-whisper

# Параметры бэкенда whisper-cpp (используются только при ASR_BACKEND=whisper-cpp).
# WHISPER_CPP_MODEL — путь к ggml-модели (скачать: models/download-ggml-model.sh large-v3-turbo).
WHISPER_CPP_MODEL=
# WHISPER_CPP_BINARY — путь/имя бинарника whisper-cli.
WHISPER_CPP_BINARY=whisper-cli
# WHISPER_CPP_LIB_PATH — каталог с библиотеками whisper.cpp (LD_LIBRARY_PATH).
WHISPER_CPP_LIB_PATH=
# WHISPER_CPP_VAD_MODEL — путь к ggml-модели Silero VAD (необязательно).
# Если задан, whisper.cpp отсекает тишину/не-речь по тем же условиям, что и
# faster-whisper (VadOptions: threshold=0.5, min_silence_duration_ms=2000
# и т.д.). Без модели распознавание идёт без VAD, чтобы не падать.
WHISPER_CPP_VAD_MODEL=

# Чанкинг длинных записей (whisper.cpp). На длинном файле whisper.cpp
# накапливает текстовый контекст между внутренними 30-с окнами одного запуска,
# из-за чего теряет речь и галлюцинирует. При длине записи больше
# WHISPER_CPP_CHUNK_SECONDS файл режется на куски, каждый распознаётся
# отдельным вызовом whisper-cli, таймкоды сдвигаются, дубликаты из области
# перекрытия склеиваются. Границы кусков ставятся в тихие точки.
# WHISPER_CPP_CHUNK_SECONDS — целевая длина куска в секундах (по умолчанию 30);
# 0 — выключить чанкинг (прежнее поведение: один вызов на весь файл).
WHISPER_CPP_CHUNK_SECONDS=30
# WHISPER_CPP_CHUNK_OVERLAP — перекрытие соседних кусков в секундах (по
# умолчанию 2). Больше — надёжнее на стыках, но чуть медленнее (больше аудио
# прогоняется дважды).
WHISPER_CPP_CHUNK_OVERLAP=2

# --- GigaAM v3 (RU) через onnx-asr: используется при ASR_BACKEND=gigaam ---
# Требуется пакет onnx-asr (без torch):
#   uv pip install --python .venv/bin/python 'onnx-asr[cpu,hub]'
# Модель скачивается с Hugging Face при первом запуске (нужен доступ в сеть;
# для офлайна укажите GIGAAM_MODEL_PATH к уже скачанному каталогу ONNX).
GIGAAM_MODEL=gigaam-v3-e2e-rnnt
# GIGAAM_MODEL_PATH — локальный каталог с ONNX-моделью (пусто — Hugging Face).
GIGAAM_MODEL_PATH=
# GIGAAM_QUANTIZATION — квантизация ONNX-модели (например, int8); пусто — нет.
GIGAAM_QUANTIZATION=
# GIGAAM_VAD — резать длинное аудио встроенным VAD onnx-asr (окно GigaAM
# 20–30 с). false — распознавать файл целиком (для коротких записей).
GIGAAM_VAD=true

# --- Гибридный ASR (#57): «плохие» сегменты основного движка → Whisper ---
# После основного прохода сегменты с низкой уверенностью, тишиной/шумом или
# очень короткие повторно распознаются резервным движком. Дорабатывается только
# часть записи — выигрыш по скорости сохраняется.
HYBRID_ASR=false
# Резервный движок: faster-whisper (модель MODEL) или whisper-cpp
# (модель WHISPER_CPP_MODEL).
HYBRID_FALLBACK_BACKEND=faster-whisper
# Порог средней логвероятности (<= 0): ниже — сегмент дорабатывается.
HYBRID_LOW_LOGPROB_THRESHOLD=-1.0
# Порог вероятности отсутствия речи Whisper (0..1): выше — дорабатывается.
HYBRID_NO_SPEECH_THRESHOLD=0.6
# Порог RMS-энергии сегмента (шкала [-1, 1]): ниже — тишина/шум.
HYBRID_SILENCE_RMS_THRESHOLD=0.003
# Сегменты короче этого значения (с) дорабатываются.
HYBRID_MIN_SEGMENT_SECONDS=0.5
# Контекст (с) вокруг сегмента при нарезке для Whisper; результат обрезается
# границами сегмента, поэтому таймстемпы не «расползаются».
HYBRID_CONTEXT_SECONDS=0.4

# Код языка речи (ru, en, ...). Пусто — автоопределение.
LANGUAGE=ru

# Устройство вычислений: cuda, cpu или auto.
DEVICE=auto

# Форматы экспорта через запятую: txt,docx,json,srt
FORMATS=txt,docx

# Точное количество говорящих. Пусто — автоопределение.
# При заданном NUM_SPEAKERS диапазон MIN_SPEAKERS/MAX_SPEAKERS игнорируется.
NUM_SPEAKERS=

# Диапазон числа говорящих для диаризации (включительно). Пусто — без границы.
# Полезно, когда точное число неизвестно, но известно, что говорящих, например,
# от 2 до 4. Требование: MIN_SPEAKERS <= MAX_SPEAKERS.
MIN_SPEAKERS=
MAX_SPEAKERS=

# Гиперпараметры диаризации pyannote (применяются к загруженной модели).
# DIARIZATION_MIN_DURATION_OFF — паузы короче этого значения (сек) склеиваются
# внутри реплики. Главный рычаг против чрезмерного дробления говорящих: 0.5
# заметно уменьшает число сегментов при том же числе говорящих. По умолчанию
# 0.5 (у самой pyannote 0.0). Отрицательным быть не может.
DIARIZATION_MIN_DURATION_OFF=0.5
# DIARIZATION_CLUSTERING_THRESHOLD — порог решения «один и тот же говорящий»
# (диапазон (0; 1]). Пусто — значение модели по умолчанию.
DIARIZATION_CLUSTERING_THRESHOLD=
# DIARIZATION_CLUSTERING_FB — регуляризация кластеризации (> 0); выше — меньше
# «Спикеров». Пусто — значение модели по умолчанию.
DIARIZATION_CLUSTERING_FB=

# Движок диаризации: auto (по числу говорящих, см. ниже), pyannote,
# nemo-speech или hybrid. NeMo-Speech.cpp даёт быструю диаризацию на GPU
# (Vulkan) и не требует токена Hugging Face; модель — Sortformer, максимум 4
# спикера. hybrid — оконный nemo-speech + глобальная склейка говорящих по
# эмбеддингам (sherpa-onnx CAM++): обходит лимит 4 и остаётся быстрым.
DIARIZATION_ENGINE=auto

# --- NeMo-Speech.cpp (движок диаризации nemo-speech) ------------------------
# Путь или имя бинарника nemo-speech. Если не найден в PATH — укажите полный
# путь, например /opt/nemo-speech/bin/nemo-speech.
NEMO_SPEECH_BINARY=nemo-speech
# Каталог lib/ бандла nemo-speech. Подмешивается в LD_LIBRARY_PATH при запуске,
# НО только если в нём нет libstdc++.so.6 и libgcc_s.so.1: эти библиотеки
# затеняют системные и ломают загрузку Vulkan-ICD на Radeon. У бандла есть
# RUNPATH $ORIGIN/../lib, поэтому без каталога запуск также работает. Если
# libstdc++/libgcc_s всё же лежат рядом — уберите их (например, в lib.bundlebak/).
NEMO_SPEECH_LIB_PATH=
# Модель диаризации: имя из каталога (sortformer), HF-репозиторий или путь к
# .gguf. Модель скачивается в ~/.cache/nemo-speech при первом запуске
# (nemo-speech pull sortformer).
NEMO_SPEECH_MODEL=nvidia/diar_streaming_sortformer_4spk-v2
# Устройство: auto, vulkan (GPU AMD/Intel) или cpu.
NEMO_SPEECH_DEVICE=auto

# --- Маршрутизация движка по числу говорящих (#64) --------------------------
# В режиме DIARIZATION_ENGINE=auto движок выбирается по числу говорящих: до
# DIARIZATION_ROUTE_MAX_SPEAKERS — быстрый nemo-speech, выше — точный pyannote.
# Число говорящих берётся из --num-speakers/--max-speakers, иначе оценивается
# дёшево (sherpa-onnx: silero VAD + эмбеддинги CAM++, несколько секунд).
# Без sherpa-onnx/модели оценка мягко деградирует, и auto безопасно выбирает
# pyannote. Явные pyannote/nemo-speech маршрутизацию не проходят.
DIARIZATION_ESTIMATE_ENABLED=true
# Сколько секунд речи анализировать оценщику (распределённо по всей записи).
DIARIZATION_ESTIMATE_SECONDS=30.0
# Порог косинусного расстояния кластеризации эмбеддингов (0; 2). Ниже — больше
# «говорящих», выше — меньше. Кластеризация идёт с complete-linkage (против
# chaining average). 0.50 настроен под complete+cosine: на реальной записи
# ~14 кластеров и ~31% сегментов в крупнейшем (average — 68–78%).
DIARIZATION_ESTIMATE_THRESHOLD=0.50
# Модель эмбеддингов оценщика: имя файла в кэше (~/.cache/audio-transcriber/
# sherpa — скачается с релизов k2-fsa/sherpa-onnx) или путь к локальному .onnx.
DIARIZATION_ESTIMATE_MODEL=3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx
# До какого числа говорящих (включительно) auto выбирает быстрый nemo-speech.
DIARIZATION_ROUTE_MAX_SPEAKERS=4

# --- Гибридная диаризация (обход лимита 4 говорящих) ------------------------
# В режиме auto при числе говорящих выше DIARIZATION_ROUTE_MAX_SPEAKERS
# выбирается гибрид (оконный nemo-speech + глобальная склейка говорящих по
# эмбеддингам CAM++), если доступны бинарник nemo-speech и sherpa-onnx с
# моделью; иначе — pyannote. Гибрид быстрее pyannote и не теряет говорящих.
DIARIZATION_HYBRID_ENABLED=true
# Длительность окна (секунды). Короче окно — выше шанс, что в него попадут
# <=4 говорящих (лимит Sortformer), но больше запусков nemo-speech.
DIARIZATION_HYBRID_WINDOW_SECONDS=90.0
# Перекрытие соседних окон (секунды): речь на границе не теряется. Дубли
# исключаются непересекающимися «зонами владения» окон.
DIARIZATION_HYBRID_OVERLAP_SECONDS=2.0
# Минимальная суммарная речь локального говорящего в окне (секунды) для
# расчёта эмбеддинга. Короче — вектор ненадёжен, а микро-кластеры из
# односложных реплик становятся мусорными «Спикерами». 3.0 согласовано с
# минимумом образца enrollment.
DIARIZATION_HYBRID_MIN_SPEAKER_SECONDS=3.0
# Linkage пороговой кластеризации гибрида: ward (по умолчанию), complete,
# average. ward (евклидова метрика на L2-нормированных эмбеддингах) даёт
# меньше хвостовых кластеров и лучшее распределение, чем complete/cosine.
DIARIZATION_HYBRID_LINKAGE=ward
# Порог кластеризации гибрида. Для ward — в единицах ЕВКЛИДОВА расстояния
# (0; 2) и НЕ совпадает с косинусным DIARIZATION_ESTIMATE_THRESHOLD. 1.30
# подобрано на реальной записи: k≈10-11, крупнейший кластер ~36% времени,
# TV к долям реплик протокола ≈0.12 (complete/0.50 давал k≈16, топ ~48%, TV 0.19).
DIARIZATION_HYBRID_THRESHOLD=1.30
# Число кластеров гибрида задаётся порогом DIARIZATION_HYBRID_THRESHOLD.
# Явное --num-speakers кластеризует ровно в это число; оценка N (для auto) —
# лишь мягкий ориентир (потолок оценка+4), а не жёсткое число кластеров,
# поэтому недооценка N не склеивает участников.

# Имена говорящих через запятую в формате ИНДЕКС=Имя, например: 0=Иван,1=Мария
SPEAKER_NAMES=

# Образцы голоса участников (enrollment-диаризация): Имя=путь к клипу.
# Через запятую; можно указать несколько образцов на одно имя. Если заданы —
# движок сам сопоставит говорящих с именами по голосу (косинусное сходство
# эмбеддингов), а не по индексу. Приоритетнее SPEAKER_NAMES.
# Пример: SPEAKER_REFERENCES=Иван=/home/me/ivan.wav,Мария=/home/me/maria.wav
SPEAKER_REFERENCES=

# Порог косинусного сходства [-1; 1] для присвоения имени по образцу голоса.
# Ниже порога говорящий остаётся «Спикер N». 0.6 — разумный баланс; выше —
# строже (меньше ложных имён), ниже — риск подписать реплики чужим голосом.
ENROLLMENT_MIN_SIMILARITY=0.6

# Каталог-библиотека образцов голоса: каждый <Имя>.wav считается образцом
# участника и ДОБАВЛЯЕТСЯ к SPEAKER_REFERENCES (одноимённые усредняются).
# Пусто — использовать ./voices, если каталог существует. Отсутствие каталога —
# предупреждение, не ошибка.
# Пример: VOICES_DIR=/home/me/voices
VOICES_DIR=

# Сохранять по одному образцу голоса на говорящего рядом с результатами:
# <OUTPUT_DIR>/<файл>.speakers/<Имя>.wav (16 кГц, моно). Эти файлы можно потом
# переложить в VOICES_DIR и использовать для enrollment. true/false.
EXPORT_SPEAKER_SAMPLES=true

# --- Подготовка эталона голоса (#29) ----------------------------------------
# Образцы (эталоны) ломают enrollment тишиной/шумом и несогласованной с тестом
# обработкой. При REFERENCE_PREPARE=true образец перед сохранением в библиотеку
# и при сопоставлении (enrollment) чистится на примитивах проекта (без новых
# зависимостей): VAD-обрезка тишины (+~0.1 с запас), ограничение длительности
# чистой речи 3–10 с и лёгкая RMS-нормализация до REFERENCE_TARGET_DBFS в
# режиме increase_only (тихие усиливаются, громкие не глушатся). Та же
# обработка применяется и к окнам говорящего — эталон и тест в одном домене.
# Денойз к эталону отдельно НЕ применяется (искажает speaker-признаки).
REFERENCE_PREPARE=true

# Минимальная длительность чистой речи образца (сек). Короче — нестабильный
# эмбеддинг: образец сохраняется, но помечается предупреждением «короткая речь».
ENROLLMENT_MIN_SAMPLE_SECONDS=3

# Максимальная длительность образца (сек). Окно эмбеддера ~5 с, поэтому длинные
# эталоны обрезаются. Требование: ENROLLMENT_MIN_SAMPLE_SECONDS <= этого значения.
ENROLLMENT_MAX_SAMPLE_SECONDS=10

# Целевой уровень RMS (dBFS) для лёгкой нормализации increase_only. -30 dBFS —
# умеренный уровень, не усиливающий шум. Должно быть отрицательным.
REFERENCE_TARGET_DBFS=-30

# Короткие подсказки для ASR через запятую (лимит ~100 токенов).
HOTWORDS=

# ---------------------------------------------------------------------------
# LLM-постобработка (извлечение имён участников + правка терминов по глоссарию)
# Локальный llama.cpp через Vulkan. По умолчанию ВЫКЛЮЧЕНО.
# ---------------------------------------------------------------------------

# Включить LLM-постобработку: true или false. По умолчанию выключено.
LLM_ENABLED=false

# Провайдер LLM: llama или openai.
#   llama  — локальный llama.cpp (llama-server). Провайдер ПО УМОЛЧАНИЮ,
#            ничего не покидает машину.
#   openai — внешний OpenAI-совместимый API (OpenAI, Ollama, vLLM, LM Studio,
#            OpenRouter и т.п.). ВНИМАНИЕ: текст стенограммы уходит на внешний
#            сервер за пределы вашей машины — проект заявлен как «100% локально».
LLM_PROVIDER=llama

# --- Только для LLM_PROVIDER=openai ---
# Базовый URL внешней LLM. Поддерживаются оба варианта эндпоинта: с префиксом
# /v1 и без него (клиент сам подберёт подходящий). Примеры:
#   OpenAI:    https://api.openai.com/v1
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
LLM_BASE_URL=

# Имя модели внешней LLM (например, gpt-4o-mini, llama3.1, qwen2.5-7b-instruct).
LLM_MODEL_NAME=

# API-ключ внешней LLM. Передаётся заголовком Authorization: Bearer <ключ>.
# Для локальных серверов (Ollama/LM Studio) обычно не нужен. В веб-интерфейсе
# хранится как секрет (web-data/secrets.json, права 0600) и не отдаётся в API.
LLM_API_KEY=

# --- Только для LLM_PROVIDER=llama (локальный llama.cpp) ---

# Путь к GGUF-модели LLM (например, Qwen2.5-7B-Instruct Q4_K_M).
LLM_MODEL=

# Путь/имя бинарника llama-server.
LLM_BINARY=llama-server

# Каталог с библиотеками llama.cpp (LD_LIBRARY_PATH). Пусто — без подстановки.
# Важно: в сборках llama.cpp нового поколения бэкенды (libggml-vulkan.so,
# libggml-cpu-*.so) грузятся динамически и ищутся РЯДОМ С БИНАРНИКОМ, поэтому
# бинарник и библиотеки должны лежать в одном каталоге.
LLM_LIB_PATH=

# Использовать GPU (Vulkan): true или false.
LLM_GPU=true

# Размер контекста LLM в токенах. 4096 — 7B Q4_K_M влезает в 8 ГБ VRAM.
# При нехватке VRAM клиент сам деградирует: частичный offload -> CPU.
LLM_CONTEXT=4096

# Таймаут одного HTTP-запроса к llama-server в секундах (по умолчанию 600).
# Покрывает длительную генерацию резюме/правок; на очень медленном CPU можно
# увеличить. Должен быть положительным числом.
LLM_REQUEST_TIMEOUT=600

# Определять имена участников через LLM (true/false). Включено по умолчанию.
# ЭКСПЕРИМЕНТАЛЬНО. По умолчанию выключено: определение имён участников ещё
# нестабильно (возможны ошибки/пропуски), поэтому используйте осознанно.
# При false имена не извлекаются, но правка терминов по глоссарию продолжает
# работать. Имя применяется, только если оно реально встречается в тексте.
LLM_EXTRACT_NAMES=false

# Собирать термины-кандидаты (которых нет в глоссарии) в файл
# <глоссарий>.suggested.txt рядом с глоссарием — для ручного разбора.
LLM_SUGGEST_TERMS=false

# Строить резюме встречи локальной LLM (тема, участники, ключевые решения,
# открытые вопросы, задачи «что сделать») в начале файла результата.
# По умолчанию включено; применяется только при LLM_ENABLED=true. Сбой резюме
# не роняет конвейер — файл сохраняется без блока «Резюме встречи».
LLM_SUMMARY=true

# Доп. инструкции к промптам LLM (текстом). Подмешиваются в системный промпт
# каждого этапа (резюме / термины / имена). Пусто — ничего не добавляется.
LLM_PROMPT_EXTRA=

# Путь к файлу с доп. инструкциями к промптам LLM. Содержимое файла
# добавляется к системному промпту каждого этапа (после LLM_PROMPT_EXTRA).
LLM_PROMPT_FILE=

# Путь(и) к файлам глоссария терминов: один путь, список через запятую
# (можно также через os.pathsep) или несколько. Термины и явные пары
# «как слышит ASR = канон» из всех файлов объединяются.
# Формат файла: по одному термину или паре в строке, «#» — комментарий.
# Пример: GLOSSARY_PATH=/path/to/glossary_tz.txt,/path/to/glossary.user.txt
GLOSSARY_PATH=

# Локальная SQLite-БД глоссария (импорт: audio-transcriber glossary import).
# Пусто — glossary.db рядом с рабочим каталогом.
GLOSSARY_DB=

# Использовать глоссарий (БД + текстовые файлы GLOSSARY_PATH). При false
# термины не правятся, хотя источник в БД может быть задан.
GLOSSARY_ENABLED=true

# Автоматически завершать прогон «протоколом»: считать резюме LLM и писать
# итоговые документы (txt/docx/...). При false прогон останавливается на
# готовой стенограмме — файлы не пишутся; в TUI протокол собирается кнопкой
# «Сформировать протокол» (Ctrl+P) по текущей стенограмме.
PROTOCOL_AUTO=true

# ---------------------------------------------------------------------------
# Очистка стенограммы от неречевых артефактов ASR
# ---------------------------------------------------------------------------

# Удалять пометки, которых не было в речи: [СМЕХ], [АПЛОДИСМЕНТЫ],
# [BLANK_AUDIO], (аплодисменты), музыкальные символы ♪ ♫ ♬ ♩ и т.п.
# Реплики, состоящие только из таких пометок (например, щелчки клавиатуры
# рядом с микрофоном, которые Whisper принял за аплодисменты), удаляются
# целиком. Обычный текст не изменяется. По умолчанию включено.
CLEAN_ARTIFACTS=true

# ---------------------------------------------------------------------------
# Устранение зацикливаний Whisper и нормализация текста
# ---------------------------------------------------------------------------

# Схлопывать подряд идущие одинаковые/почти одинаковые реплики: Whisper
# иногда «залипает» и повторяет строку много раз («Продолжение следует»,
# «Спасибо за просмотр», титры редактора/корректора субтитров и т.п.).
# Из серии повторов остаётся одна реплика. По умолчанию включено.
COLLAPSE_REPEATS=true

# Минимальная длина (в словах) повторяющейся реплики, которую можно схлопнуть.
# Защита от удаления короткой осмысленной речи («да, да», «ну да»).
REPEAT_MIN_WORDS=2

# Порог сходства «почти одинаковых» реплик (0; 1]. Выше — строже, меньше
# ложных схлопываний. По умолчанию 0.9.
REPEAT_SIMILARITY=0.9

# Безопасная нормализация текста реплик: схлопывание повторной пунктуации
# (!!! -> !), лишних многоточий (...), двойных пробелов, пробелов перед
# знаками. Слова НЕ переписываются; числа/даты — только элементарные
# безопасные случаи (пробелы внутри десятичной дроби, вокруг ':' и '%').
# Текст без отклонений не изменяется. По умолчанию включено.
NORMALIZE_TEXT=true

# ---------------------------------------------------------------------------
# Пометка наложения речи (перекрытие говорящих)
# ---------------------------------------------------------------------------

# Помечать реплики, попавшие в зоны, где одновременно говорили >= 2 человек.
# В txt/docx — пометка «[наложение речи]», в json — поле overlap: true.
# Требует обычной (не эксклюзивной) разметки pyannote; при её отсутствии
# пометок не будет (ошибки нет). По умолчанию включено.
MARK_OVERLAP=true

# ---------------------------------------------------------------------------
# Слияние кластеров с одинаковым именем говорящего
# ---------------------------------------------------------------------------

# Enrollment работает «много-к-одному»: один реальный участник, раздробленный
# диаризацией на несколько кластеров, получает одно и то же имя в нескольких
# кластерах. При включённой опции такие кластеры сводятся в одного говорящего
# (реплики и сов-говорящие наложения переназначаются на один id, дубликаты
# убираются). Сливаются только говорящие с ТОЧНЫМ совпадением уверенного имени
# (enrollment или ручное/--speaker-name); безымянные «Спикер N» — не сливаются.
# По умолчанию включено.
MERGE_SAME_NAME_SPEAKERS=true

# ---------------------------------------------------------------------------
# Разметка уверенности распознавания (avg_logprob)
# ---------------------------------------------------------------------------

# Порог «низкой уверенности» ASR (число <= 0). Реплики со средним avg_logprob
# ниже порога помечаются: в txt/docx — «⚠ [низкая уверенность]», в json —
# поле low_confidence: true (плюс всегда пишется avg_logprob).
# У faster-whisper значение есть всегда; whisper.cpp отдаёт вероятности
# токенов только в полном JSON (используется автоматически). Если движок
# вероятностей не даёт, реплика не помечается. По умолчанию -1.0.
LOW_CONFIDENCE_THRESHOLD=-1.0

# ---------------------------------------------------------------------------
# Шумоподавление (денойз) на DeepFilterNet
# ---------------------------------------------------------------------------

# Подавлять фоновый шум перед распознаванием и диаризацией: true или false.
# По умолчанию включено. Этап требует пакета deepfilternet (сборка libDF — на
# Rust) и скачивает модель ~9 МБ при первом запуске (дальше всё офлайн).
# Если пакет не установлен/недоступен — этап мягко пропускается
# с предупреждением в лог, конвейер продолжает работать на исходном аудио.
# Установка описана в README (раздел «Шумоподавление (денойз)»).
DENOISE=true

# ---------------------------------------------------------------------------
# Постадийный кэш дорогих этапов (шумоподавление, распознавание, диаризация)
# ---------------------------------------------------------------------------

# Кэшировать результаты дорогих стадий: true или false. По умолчанию включено.
# При повторном запуске на том же аудиофайле с теми же параметрами (бэкенд,
# модель, язык, устройство, число говорящих, денойз и т.п.) денойз/ASR/диаризация
# не пересчитываются, а берутся из кэша. Это же даёт возобновление после сбоя:
# прогон, упавший на диаризации, при повторе переиспользует готовый ASR.
# Битый или несовместимый кэш просто игнорируется (с предупреждением) и стадия
# пересчитывается. Очистка: флаг --clear-cache у команды transcribe.
USE_CACHE=true

# Каталог кэша. Пусто — <OUTPUT_DIR>/.cache.
CACHE_DIR=

# ---------------------------------------------------------------------------
# Десктоп-уведомления о завершении обработки (Linux: notify-send)
# ---------------------------------------------------------------------------

# Показывать десктоп-уведомление по завершении обработки: true или false.
# По умолчанию включено. Уведомление передаётся локальной утилите notify-send
# (libnotify) без обращений к сети; если её нет — тихий no-op без ошибки.
# Отключение: флаг --no-notify у команды transcribe.
NOTIFICATIONS=true

# ---------------------------------------------------------------------------
# Таймлайн «кто когда говорил»
# ---------------------------------------------------------------------------

# Строить таймлайн по результату диаризации: самодостаточный HTML
# (<OUTPUT_DIR>/<имя файла>.timeline.html — горизонтальные дорожки говорящих на
# общей временной оси, без внешних CDN) и подробная текстовая сводка в лог
# («Спикер N (Имя): 00:00–00:29, 00:53–00:59, …»). По умолчанию включено.
# Если диаризация выключена или ни одна реплика не привязана к говорящему,
# таймлайн мягко пропускается без ошибки. Отключение: --no-timeline.
TIMELINE=true

# ---------------------------------------------------------------------------
# Автоисправление опечаток ASR (только русский язык, через pymorphy3)
# ---------------------------------------------------------------------------

# Включить автоисправление: true или false. По умолчанию выключено.
ENABLE_CORRECTION=false

# Минимальная длина слова, которое можно исправлять.
# Более короткие слова (в т.ч. короткие фамилии) не трогаются.
CORRECTION_MIN_WORD_LENGTH=6

# Минимальное сходство опечатки и кандидата из словаря русского языка (0; 1].
# Выше — меньше ложных замен; ниже — агрессивнее правки. Правки консервативны:
# допускается не более одной правки символа, а слова с латиницей не трогаются.
# 0.93 не даёт тех-заимствованиям («залогинился», «залочился») тянуться к
# похожим русским словам; корректная опечатка в один символ всё ещё правится.
CORRECTION_MIN_SIMILARITY=0.93

# Максимум кандидатов OpenCorpora на один префикс при поиске замены.
CORRECTION_MAX_CANDIDATES=8000

# Директория для результатов.
OUTPUT_DIR=output

# Подробный режим логирования: true или false.
VERBOSE=false
