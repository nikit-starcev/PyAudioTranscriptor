# Скопируйте этот файл в config.env и укажите свои значения.
# config.env не попадает в git (см. .gitignore) — токен и личные настройки
# останутся только у вас на компьютере.
#
# Пустое значение параметра означает "не передавать его программе" —
# будет использовано поведение по умолчанию (см. README).

# Токен доступа Hugging Face для модели диаризации.
# Как получить — см. README, раздел "Токен доступа для диаризации".
HF_TOKEN=

# Путь к локальной копии модели диаризации (директория с config.yaml).
# Если задан — модель грузится с диска полностью офлайн, токен и сеть не нужны.
PYANNOTE_LOCAL_MODEL=

# Модель распознавания faster-whisper: tiny, base, small, medium,
# large-v3-turbo, large-v3.
MODEL=large-v3-turbo

# Движок распознавания: faster-whisper (CUDA/CPU) или whisper-cpp
# (GPU через Vulkan — для AMD-карт без ROCm).
ASR_BACKEND=faster-whisper

# Параметры бэкенда whisper-cpp (используются только при ASR_BACKEND=whisper-cpp).
# WHISPER_CPP_MODEL — путь к ggml-модели (скачать: models/download-ggml-model.sh large-v3-turbo).
WHISPER_CPP_MODEL=
# WHISPER_CPP_BINARY — путь/имя бинарника whisper-cli.
WHISPER_CPP_BINARY=whisper-cli
# WHISPER_CPP_LIB_PATH — каталог с библиотеками whisper.cpp (LD_LIBRARY_PATH).
WHISPER_CPP_LIB_PATH=

# Код языка речи (ru, en, ...). Пусто — автоопределение.
LANGUAGE=ru

# Устройство вычислений: cuda, cpu или auto.
DEVICE=auto

# Форматы экспорта через запятую: txt,docx,json,srt
FORMATS=txt,docx

# Точное количество говорящих. Пусто — автоопределение.
NUM_SPEAKERS=

# Имена говорящих через запятую в формате ИНДЕКС=Имя, например: 0=Иван,1=Мария
SPEAKER_NAMES=

# Короткие подсказки для ASR через запятую (лимит ~100 токенов).
HOTWORDS=

# ---------------------------------------------------------------------------
# LLM-постобработка (извлечение имён участников + правка терминов по глоссарию)
# Локальный llama.cpp через Vulkan. По умолчанию ВЫКЛЮЧЕНО.
# ---------------------------------------------------------------------------

# Включить LLM-постобработку: true или false. По умолчанию выключено.
LLM_ENABLED=false

# Путь к GGUF-модели LLM (например, Qwen2.5-7B-Instruct Q4_K_M).
LLM_MODEL=

# Путь/имя бинарника llama-server.
LLM_BINARY=llama-server

# Каталог с библиотеками llama.cpp (LD_LIBRARY_PATH). Пусто — без подстановки.
# Важно: в сборках llama.cpp нового поколения бэкенды (libggml-vulkan.so,
# libggml-cpu-*.so) грузятся динамически и ищутся РЯДОМ С БИНАРНИКОМ, поэтому
# бинарник и библиотеки должны лежать в одном каталоге.
LLM_LIB_PATH=

# Использовать GPU (Vulkan): true или false.
LLM_GPU=true

# Размер контекста LLM в токенах. 4096 — 7B Q4_K_M влезает в 8 ГБ VRAM.
# При нехватке VRAM клиент сам деградирует: частичный offload -> CPU.
LLM_CONTEXT=4096

# Определять имена участников через LLM (true/false). Включено по умолчанию.
# При false имена не извлекаются, но правка терминов по глоссарию продолжает
# работать. Имя применяется, только если оно реально встречается в тексте.
LLM_EXTRACT_NAMES=true

# Собирать термины-кандидаты (которых нет в глоссарии) в файл
# <глоссарий>.suggested.txt рядом с глоссарием — для ручного разбора.
LLM_SUGGEST_TERMS=false

# Путь(и) к файлам глоссария терминов: один путь, список через запятую
# (можно также через os.pathsep) или несколько. Термины и явные пары
# «как слышит ASR = канон» из всех файлов объединяются.
# Формат файла: по одному термину или паре в строке, «#» — комментарий.
# Пример: GLOSSARY_PATH=/path/to/glossary_tz.txt,/path/to/glossary.user.txt
GLOSSARY_PATH=

# ---------------------------------------------------------------------------
# Автоисправление опечаток ASR (только русский язык, через pymorphy3)
# ---------------------------------------------------------------------------

# Включить автоисправление: true или false. По умолчанию выключено.
ENABLE_CORRECTION=false

# Минимальная длина слова, которое можно исправлять.
# Более короткие слова (в т.ч. короткие фамилии) не трогаются.
CORRECTION_MIN_WORD_LENGTH=6

# Минимальное сходство опечатки и кандидата из словаря русского языка (0; 1].
# Выше — меньше ложных замен; ниже — агрессивнее правки.
# 0.85 пропускает «взаимоприимания»→«взаимопонимания» (~0.87).
CORRECTION_MIN_SIMILARITY=0.85

# Максимум кандидатов OpenCorpora на один префикс при поиске замены.
CORRECTION_MAX_CANDIDATES=8000

# Директория для результатов.
OUTPUT_DIR=output

# Подробный режим логирования: true или false.
VERBOSE=false
